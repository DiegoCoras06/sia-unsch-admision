{
  "name": "sia-unsch",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema Integral de AdmisiÃ³n UNSCH â€” proyecto acadÃ©mico (Spec-Driven Development)",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:start": "npm run db:start -w @sia/backend",
    "db:stop": "npm run db:stop -w @sia/backend",
    "db:setup": "npm run db:setup -w @sia/backend",
    "dev": "concurrently -k -n api,web -c red,yellow \"npm run dev -w @sia/backend\" \"npm run start -w @sia/frontend\"",
    "build": "npm run build -w @sia/contracts && npm run build -w @sia/backend && npm run build -w @sia/frontend",
    "test": "npm run test -w @sia/backend",
    "test:e2e": "node scripts/e2e-runner.mjs",
    "typecheck": "npm run typecheck -w @sia/backend",
    "lint": "eslint apps packages scripts calidad --max-warnings=0",
    "format": "prettier --write --ignore-unknown apps packages scripts calidad docs specs *.json *.md *.mjs",
    "format:check": "prettier --check --ignore-unknown apps packages scripts calidad docs specs *.json *.md *.mjs",
    "rds:check": "npm run rds:check -w @sia/backend",
    "rds:setup": "npm run rds:setup -w @sia/backend",
    "dev:rds": "concurrently -k -n api,web -c red,yellow \"npm run dev:rds -w @sia/backend\" \"npm run start -w @sia/frontend\"",
    "izipay:check": "npm run izipay:check -w @sia/backend",
    "ses:check": "npm run ses:check -w @sia/backend",
    "rds:migrate": "npm run rds:migrate -w @sia/backend"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.10.2",
    "concurrently": "10.0.6",
    "eslint": "10.15.0",
    "lighthouse": "13.6.0",
    "playwright-core": "1.64.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@16.14.0-beta.17": true,
    "@embedded-postgres/linux-x64@16.14.0-beta.17": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "@swc/core@1.16.21": true
  },
  "overrides": {
    "uuid": "^11.1.1",
    "effect": "^3.22.1",
    "@jest/reporters": {
      "glob": "14.0.3"
    },
    "jest-config": {
      "glob": "14.0.3"
    },
    "jest-runtime": {
      "glob": "14.0.3"
    },
    "test-exclude": {
      "glob": "14.0.3",
      "minimatch": "11.0.9"
    }
  }
}
