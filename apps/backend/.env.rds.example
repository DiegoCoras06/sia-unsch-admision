# Copia este archivo como .env.rds y escribe TU contraseña de RDS. .env.rds no se sube a Git (.gitignore).
# Uso: npm run rds:check · npm run rds:setup · npm run dev:rds
NODE_ENV=development
APP_ENV=dev
API_HOST=127.0.0.1
API_PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:4200

# RDS PostgreSQL (us-east-2). Base dedicada "admision_unsch" (rds:setup la crea si no existe).
# Si tu contraseña tiene caracteres especiales (@ : / # ? %), escríbela codificada: @ → %40, : → %3A, / → %2F, # → %23
DATABASE_URL=postgresql://postgres:ESCRIBE_TU_CONTRASENA@admision-unsch-db.cn2kquuq84sf.us-east-2.rds.amazonaws.com:5432/admision_unsch
# Certificado raíz oficial de AWS (verify-full)
DB_SSL_CA=certs/global-bundle.pem
DB_SSL_ROOT_CERT=certs/rds-us-east-2-root.pem
DB_MAX_CONNECTIONS=5

JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
IDENTITY_TOKEN_SECRET=dev-only-identity-token-secret-0123456789abcdef
HMAC_SECRET=dev-only-hmac-secret-0123456789abcdef0123456789

IDENTITY_PROVIDER=mock
# Para DNI reales con un proveedor de consulta (token propio):
# IDENTITY_PROVIDER=http
# IDENTITY_HTTP_URL=https://<proveedor>/v1/reniec/dni?numero={dni}
# IDENTITY_HTTP_TOKEN=<tu token>
EMAIL_PROVIDER=file
LOG_LEVEL=info

# Izipay (ADR-016): ambiente sandbox, sin cobros reales. Credenciales en Panel de comercio > Desarrolladores > Claves
# Cambia a izipay cuando completes las claves (comprueba antes con: npm run izipay:check)
PAYMENTS_PROVIDER=mock
# URL pública de la API para la notificación IPN (solo con HTTPS, p. ej. en AWS)
PUBLIC_API_URL=
IZIPAY_ENV=sandbox
IZIPAY_API_URL=https://sandbox-api-pw.izipay.pe
IZIPAY_MERCHANT_CODE=
IZIPAY_API_KEY=
IZIPAY_HASH_KEY=
IZIPAY_PUBLIC_KEY=

# Asistente virtual (ADR-017). Sin clave responde en modo básico. Clave en https://openrouter.ai/keys (solo servidor)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
CHAT_DAILY_BUDGET_USD=1
CHAT_RETENTION_DAYS=90

# Yape con Culqi (ADR-019): CulqiPanel > Desarrollo > API Keys. Sin las dos llaves, Yape no se ofrece.
# Comprobación: npm run culqi:check
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
