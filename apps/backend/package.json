{
  "name": "@sia/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n db,api -c blue,red \"tsx scripts/db.ts start\" \"tsx watch --env-file-if-exists=.env src/server.ts\"",
    "db:start": "tsx scripts/db.ts start",
    "db:stop": "tsx scripts/db.ts stop",
    "db:setup": "tsx scripts/db.ts setup",
    "db:reset": "tsx scripts/db.ts reset",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "rds:check": "tsx scripts/rds.ts check",
    "rds:setup": "tsx scripts/rds.ts setup",
    "dev:rds": "tsx watch --env-file=.env.rds src/server.ts",
    "culqi:check": "tsx scripts/culqi.ts",
    "ses:check": "tsx scripts/ses.ts",
    "apiperu:check": "tsx --env-file=.env.rds scripts/apiperu.ts",
    "rds:migrate": "tsx scripts/rds.ts migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/client-sesv2": "^3.1163.0",
    "@aws-sdk/client-sqs": "^3.1163.0",
    "@aws-sdk/s3-presigned-post": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@codegenie/serverless-express": "5.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sia/contracts": "0.1.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "exceljs": "^4.4.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "pdfkit": "^0.20.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "embedded-postgres": "16.14.0-beta.17",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
